# Base URL for the backend API.
#
# Development: leave as the relative path below — the Vite dev server
# proxies /api requests to http://localhost:5000 (see vite.config.ts).
#
# Production (e.g. deploying to Vercel while the API runs on Render):
# set this to the full deployed API URL, e.g.
#   VITE_API_BASE_URL=https://student-task-manager-api.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1
